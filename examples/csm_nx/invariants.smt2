(set-logic ALL)
(declare-const s Real)
(declare-const x Real)
(declare-const a Real)
(push)
(assert (and (<= (- 1) s 1) (<= (- 1) x 1) (<= 0 a 1)))
(define-fun next () Real (+ (* a s) (* (- 1 a) x)))
(assert (or (< next (- 1)) (> next 1)))
(check-sat)
(pop)
(declare-const occupied (Array Int Bool))
(declare-const mem (Array Int Int))
(declare-const key Int)
(declare-const protected Int)
(declare-const proposal Int)
(declare-const accepted Bool)
(define-fun nextmem () (Array Int Int)
 (ite (and accepted (not (select occupied key))) (store mem key proposal) mem))
(push)
(assert (select occupied protected))
(assert (distinct (select mem protected) (select nextmem protected)))
(check-sat)
(pop)

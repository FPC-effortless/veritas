{
  "checkpoint_every": 128,
  "cpu_threads": 4,
  "dataset": {
    "cache": "../../../../.trainlab/fullcycle003-data",
    "source_plan": "data-plan.json"
  },
  "deterministic": true,
  "device": "cuda",
  "evaluation_case_limit": 32,
  "evaluation_generation_limit": 8,
  "evaluation_max_new_tokens": 128,
  "evaluation_token_budget": 8192,
  "model": {
    "activation_checkpointing": true,
    "backend": "tac104",
    "context": 1024,
    "heads": 4,
    "layers": 40,
    "vocab_size": 3072,
    "width": 120
  },
  "parameter_target": 10000000,
  "parameter_tolerance": 0.01,
  "precision": "fp32",
  "schema": "trainlab.pipeline.v1",
  "seed": 10601,
  "stages": [
    {
      "batch_size": 8,
      "betas": [
        0.9,
        0.95
      ],
      "gradient_accumulation": 4,
      "learning_rate": 0.0003,
      "lr_schedule": "cosine",
      "min_lr_ratio": 0.1,
      "name": "pretrain",
      "sequence_length": 512,
      "steps": 12208,
      "warmup_steps": 256,
      "weight_decay": 0.1
    },
    {
      "batch_size": 4,
      "betas": [
        0.9,
        0.95
      ],
      "gradient_accumulation": 2,
      "learning_rate": 0.00015,
      "lr_schedule": "cosine",
      "min_lr_ratio": 0.2,
      "name": "midtrain",
      "replay_weight": 0.3,
      "steps": 250,
      "warmup_steps": 20
    },
    {
      "batch_size": 4,
      "betas": [
        0.9,
        0.95
      ],
      "gradient_accumulation": 2,
      "learning_rate": 0.00015,
      "lr_schedule": "cosine",
      "min_lr_ratio": 0.2,
      "name": "sft",
      "replay_weight": 0.2,
      "steps": 3000,
      "warmup_steps": 50
    },
    {
      "batch_size": 2,
      "beta": 0.1,
      "gradient_accumulation": 2,
      "learning_rate": 5e-05,
      "lr_schedule": "cosine",
      "min_lr_ratio": 0.2,
      "name": "dpo",
      "replay_weight": 0.2,
      "steps": 1000,
      "warmup_steps": 25
    },
    {
      "batch_size": 1,
      "clip_epsilon": 0.2,
      "group_size": 4,
      "kl_beta": 0.02,
      "learning_rate": 1e-05,
      "lr_schedule": "cosine",
      "max_new_tokens": 128,
      "min_lr_ratio": 0.2,
      "name": "rl",
      "replay_weight": 0.1,
      "rl_mode": "completion",
      "steps": 64,
      "temperature": 1.0,
      "warmup_steps": 8
    }
  ],
  "tokenizer": {
    "kind": "artifact"
  }
}
